APP_ENV=development
LOG_LEVEL=INFO
TRADING_ENV=TESTNET
TRADING_MODE=PAPER

# Never enable live trading from this template.
ALLOW_MAINNET=false
LIVE_TRADING_ENABLED=false
MAINNET_CONFIRMATION=
MAINNET_LEGAL_ELIGIBILITY_CONFIRMED=false

# Read-only dashboard access. Set a long random value in your private .env.
DASHBOARD_ACCESS_TOKEN=
MUMIN_PAPER_DB_PATH=data/mumin_public_paper.db

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIMEOUT_SECONDS=10

INITIAL_CAPITAL_USD=70.00
MAX_CAPITAL_ALLOCATION_USD=70.00
MAX_TRADE_ALLOCATION_USD=5.00
MIN_TRADE_ALLOCATION_USD=5.00
CAPITAL_RESERVE_PERCENT=20
MAX_RISK_PER_TRADE_PERCENT=0.50
MAX_DAILY_LOSS_PERCENT=2.00
MAX_DRAWDOWN_PERCENT=5.00
MAX_OPEN_POSITIONS=2

QUOTE_ASSET=USDT
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT
ENABLE_BNB_FEE_DISCOUNT=true
BNB_FEE_ASSET=BNB
REQUIRE_BNB_BALANCE_FOR_DISCOUNT=true

DATABASE_URL=sqlite:///./data/mumin_trader.db
