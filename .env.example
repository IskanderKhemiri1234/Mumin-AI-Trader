APP_ENV=development
LOG_LEVEL=INFO
TRADING_ENV=TESTNET
TRADING_MODE=PAPER

# Never enable live trading from this template.
ALLOW_MAINNET=false
LIVE_TRADING_ENABLED=false
# Only validates Spot Testnet order parameters; never sends an order to the matching engine.
TESTNET_ORDER_PREFLIGHT_ENABLED=false
# Sends orders only to isolated Binance Spot Testnet; keep disabled by default.
# Set TRADING_MODE=TESTNET only for an explicitly approved Testnet lifecycle run.
TESTNET_SPOT_EXECUTION_ENABLED=false
MAINNET_CONFIRMATION=
MAINNET_LEGAL_ELIGIBILITY_CONFIRMED=false

# Private dashboard sign-in. Choose a password of at least 12 characters in your private .env.
DASHBOARD_PASSWORD=
MUMIN_PAPER_DB_PATH=data/mumin_public_paper.db

# Separate production Spot account read-only key; never reused by Testnet execution.
# Create a key with read-only permissions only; disable trading and withdrawals in Binance.
BINANCE_ACCOUNT_READONLY_API_KEY=
BINANCE_ACCOUNT_READONLY_API_SECRET=

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIMEOUT_SECONDS=10

INITIAL_CAPITAL_USD=70.00
MAX_CAPITAL_ALLOCATION_USD=70.00
MAX_TRADE_ALLOCATION_USD=5.00
MIN_TRADE_ALLOCATION_USD=5.00
CAPITAL_RESERVE_PERCENT=20
MAX_RISK_PER_TRADE_PERCENT=0.50
MAX_DAILY_LOSS_PERCENT=2.00
MAX_DRAWDOWN_PERCENT=5.00
MAX_OPEN_POSITIONS=2

QUOTE_ASSET=USDT
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,LINKUSDT
ENABLE_BNB_FEE_DISCOUNT=true
BNB_FEE_ASSET=BNB
REQUIRE_BNB_BALANCE_FOR_DISCOUNT=true

DATABASE_URL=sqlite:///./data/mumin_trader.db
