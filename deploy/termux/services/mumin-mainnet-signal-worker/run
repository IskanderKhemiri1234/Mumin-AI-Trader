#!/data/data/com.termux/files/usr/bin/sh
set -eu
ROOT="$HOME/Mumin-AI-Trader"
LOG_DIR="$HOME/.mumin-ai-trader/logs"
mkdir -p "$LOG_DIR"
cd "$ROOT"
if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi
export PYTHONUNBUFFERED=1
export MAINNET_SIGNAL_INTERVAL_SECONDS="${MAINNET_SIGNAL_INTERVAL_SECONDS:-60}"
export MAINNET_AUTONOMOUS_EXECUTION_ENABLED="${MAINNET_AUTONOMOUS_EXECUTION_ENABLED:-false}"
export MAINNET_AUTONOMOUS_BOOT_RESUME_ENABLED="${MAINNET_AUTONOMOUS_BOOT_RESUME_ENABLED:-false}"
exec python scripts/mainnet_worker_supervisor.py \
  --interval-seconds "$MAINNET_SIGNAL_INTERVAL_SECONDS" \
  --restart-initial-seconds 2 \
  --restart-max-seconds 60 \
  >> "$LOG_DIR/mainnet-signal-worker.log" 2>&1
